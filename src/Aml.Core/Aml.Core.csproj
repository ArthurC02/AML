<Project Sdk="Microsoft.NET.Sdk">
  <!-- Zero dependencies: all decision logic is pure code. -->
  <ItemGroup>
    <!-- Public reference tables (attribution, source and license in each file's header lines). -->
    <EmbeddedResource Include="Normalization\Data\*.txt" LogicalName="%(Filename)%(Extension)" />
    <!-- Their notices and license texts go with every build that contains them. -->
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\licenses\*.txt" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
