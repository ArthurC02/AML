<?xml version="1.0" encoding="utf-8"?>
<!--
  Schema for the AML SQL catalogs: Sql.<provider>.xml, one file per database
  (Sql.sqlite.xml now; Sql.sqlserver.xml / Sql.oracle.xml when those land).
  The file name selects the provider. DML only; DDL lives in DbUp scripts.
  Rules not expressible in XSD 1.0 are enforced by SqlCatalog at startup:
    - statement id must start with "<module name>.";
    - every Sql.*.xml must define the same set of statement ids.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:aml:sql:v1"
           xmlns:a="urn:aml:sql:v1"
           targetNamespace="urn:aml:sql:v1"
           elementFormDefault="qualified">

  <xs:element name="sqlCatalog">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="module" type="ModuleType" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="version" type="xs:positiveInteger" use="required"/>
    </xs:complexType>

    <xs:unique name="UniqueModule">
      <xs:selector xpath="a:module"/>
      <xs:field xpath="@name"/>
    </xs:unique>
    <xs:unique name="UniqueStatementId">
      <xs:selector xpath="a:module/a:statement"/>
      <xs:field xpath="@id"/>
    </xs:unique>
  </xs:element>

  <!-- System + one per L2 module (docs/02 §2). -->
  <xs:simpleType name="ModuleName">
    <xs:restriction base="xs:string">
      <xs:enumeration value="System"/>
      <xs:enumeration value="Case"/>
      <xs:enumeration value="Batch"/>
      <xs:enumeration value="Extraction"/>
      <xs:enumeration value="Identity"/>
      <xs:enumeration value="Screening"/>
      <xs:enumeration value="Explanation"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="ModuleType">
    <xs:sequence>
      <xs:element name="statement" type="StatementType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" type="ModuleName" use="required"/>
  </xs:complexType>

  <!-- Module.PascalCaseName, e.g. Case.GetById -->
  <xs:simpleType name="StatementId">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z][A-Za-z]*\.[A-Z][A-Za-z0-9]*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StatementKind">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Select"/>
      <xs:enumeration value="Insert"/>
      <xs:enumeration value="Update"/>
      <xs:enumeration value="Delete"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="StatementType">
    <xs:sequence>
      <xs:element name="description" type="xs:string"/>
      <xs:element name="sql" type="xs:string"/>
    </xs:sequence>
    <xs:attribute name="id" type="StatementId" use="required"/>
    <xs:attribute name="kind" type="StatementKind" use="required"/>
  </xs:complexType>
</xs:schema>
