{
  "$id": "aml:AnalysisLineage:v10",
  "type": [
    "object",
    "null"
  ],
  "properties": {
    "inputFiles": {
      "description": "輸入檔與其雜湊",
      "type": "array",
      "items": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "name": {
            "description": "輸入檔名",
            "type": "string"
          },
          "sha256": {
            "description": "檔案內容的 SHA-256（multipart 為上傳位元組；JSON 輸入與重新分析為文字的 UTF-8）",
            "type": "string"
          }
        },
        "required": [
          "name",
          "sha256"
        ]
      }
    },
    "profiles": {
      "description": "分析用到的每一筆名單與其來源版本",
      "type": "array",
      "items": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "profileId": {
            "description": "名單編號（不含 DJ: 前綴）",
            "type": "string"
          },
          "origin": {
            "description": "LIST_DATABASE：內容與名單庫某一版相同；CASE_FILES：只來自案件檔",
            "type": "string"
          },
          "listVersion": {
            "description": "相同內容的名單庫版本；只來自案件檔時為 null",
            "type": [
              "string",
              "integer",
              "null"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          },
          "contentHash": {
            "description": "正規化匯出文字的 SHA-256，與名單庫的內容雜湊同一算法",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "profileId",
          "origin"
        ]
      }
    },
    "sourcePolicyVersion": {
      "description": "名單條件規則版本",
      "type": "string"
    },
    "codeCatalogVersion": {
      "description": "代碼字典版本",
      "type": "string"
    },
    "schemaVersion": {
      "description": "儲存格式（JSON Schema）版本",
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)$"
    },
    "appVersion": {
      "description": "應用程式版本（組件 informational version）",
      "type": "string"
    },
    "asOf": {
      "description": "分析基準日（UTC 日期）：PEP 職務是否都已結束以此日判斷",
      "type": "string",
      "format": "date"
    },
    "newsModelVersion": {
      "description": "讀了附加新聞的新聞模型版本；未設定模型或沒有命中附有新聞時為 null",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "pages": {
      "description": "分析所用的收到網頁與其內文版本；網頁固定在案件輸入檔中，重新分析讀同一版本；沒有網頁時省略",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "pageId": {
            "description": "網頁編號",
            "type": "string"
          },
          "url": {
            "description": "正規化網址",
            "type": "string"
          },
          "fetchedAt": {
            "description": "取得時間",
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "contentHash": {
            "description": "回應內容的 SHA-256",
            "type": [
              "string",
              "null"
            ]
          },
          "textHash": {
            "description": "內文（UTF-8）的 SHA-256：此 revision 所用的內文版本",
            "type": "string"
          }
        },
        "required": [
          "pageId",
          "url",
          "textHash"
        ]
      },
      "default": null
    }
  },
  "required": [
    "inputFiles",
    "profiles",
    "sourcePolicyVersion",
    "codeCatalogVersion",
    "schemaVersion",
    "appVersion",
    "asOf"
  ]
}
