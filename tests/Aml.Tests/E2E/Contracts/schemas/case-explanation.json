              },
              "keyEvidenceOrGaps": {
                "description": "關鍵佐證或缺口",
                "type": "string"
              },
              "conclusion": {
                "description": "結論：身分判斷、對外結果、理由碼與第 22 條建議",
                "type": "string"
              }
            },
            "required": [
              "internalData",
              "externalData",
              "agreementsAndDifferences",
              "keyEvidenceOrGaps",
              "conclusion"
            ]
          },
          "newsDigest": {
            "description": "附加新聞的人物、事件與固定句型摘要，依規則讀出；不影響任何判斷。沒有附加新聞時為 null",
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "sourceRef": {
                "description": "新聞在來源中的引用編號（S#）",
                "type": "string"
              },
              "people": {
                "description": "報導中的人物；名單人物在前",
                "type": "array",
                "items": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "name": {
                      "description": "報導中的姓名或匿稱（如 王姓男子、王男）",
                      "type": "string",
                      "x-sensitivity": "PERSONAL"
                    },
                    "match": {
                      "description": "PROFILE_NAME：名單人物（姓名相同，或全文唯一同姓全名的匿稱）；PROFILE_SURNAME：與名單人物同姓的匿稱；OTHER_PERSON：其他人",
                      "enum": [
                        "PROFILE_NAME",
                        "PROFILE_SURNAME",
                        "OTHER_PERSON"
                      ]
                    },
                    "roles": {
                      "description": "報導中緊接在姓名前的身分或職稱，依出現順序",
                      "type": "array",
                      "items": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "party": {
                      "description": "依身分或職稱歸類：SUSPECT、VICTIM、WITNESS、OFFICIAL；看不出時為 null",
                      "enum": [
                        "SUSPECT",
                        "VICTIM",
                        "WITNESS",
                        "OFFICIAL",
                        null
                      ]
                    },
                    "mentions": {
                      "description": "出現次數",
                      "type": [
                        "string",
                        "integer"
                      ],
                      "pattern": "^-?(?:0|[1-9]\\d*)$"
                    },
                    "identifiers": {
                      "description": "報導緊接姓名寫出的識別資訊（性別、年齡、出生日期、身分證字號、國籍、住居地、職業、任職機構），依出現順序",
                      "type": "array",
                      "items": {
                        "type": [
                          "object",
                          "null"
                        ],
                        "properties": {
                          "kind": {
                            "description": "GENDER（性別）、AGE（年齡）、BIRTH_DATE（出生日期或年次）、ID_NUMBER（身分證字號，已遮罩）、NATIONALITY（國籍）、RESIDENCE（住居地或籍貫）、OCCUPATION（職業或職稱）、EMPLOYER（任職機構）",
                            "enum": [
                              "GENDER",
                              "AGE",
                              "BIRTH_DATE",
                              "ID_NUMBER",
                              "NATIONALITY",
                              "RESIDENCE",
                              "OCCUPATION",
                              "EMPLOYER"
                            ]
                          },
                          "text": {
                            "description": "報導原文；身分證字號時為 null，見 number",
                            "type": [
                              "string",
                              "null"
                            ],
                            "x-sensitivity": "PERSONAL"
                          },
                          "number": {
                            "description": "身分證字號，已遮罩；其他種類時為 null",
                            "type": [
                              "string",
                              "null"
                            ],
                            "default": null,
                            "x-sensitivity": "IDENTIFIER"
                          }
                        },
                        "required": [
                          "kind"
                        ]
                      }
                    }
                  },
                  "required": [
                    "name",
                    "match",
                    "roles",
                    "mentions",
                    "identifiers"
                  ]
                }
              },
