              "reasonCodes": {
                "description": "第 22 條理由碼",
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "pendingChecks": {
                "description": "尚未執行的查核事項",
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "advisory": {
                "description": "永遠為 true：建議僅供參考",
                "type": "boolean"
              }
            },
            "required": [
              "reasonCodes",
              "pendingChecks"
            ]
          },
          "reasonCodes": {
            "description": "身分判斷的理由碼",
            "type": "array",
            "items": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "dataQualityFindings": {
            "description": "資料品質 finding，見 /api/codes",
            "type": "array",
            "items": {
              "type": [
                "string",
                "null"
              ]
            }
          },
