            "items": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "ref": {
                  "description": "摘要中的引用編號（S1、S2…）",
                  "type": "string"
                },
                "id": {
                  "description": "來源編號",
                  "type": "string"
                },
                "name": {
                  "description": "來源名稱或新聞出處與標題",
                  "type": "string"
                },
                "url": {
                  "description": "來源網址",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "publishedOn": {
                  "description": "發布日期",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "retrievedOn": {
                  "description": "取得日期",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "usedFor": {
                  "description": "用途：PROFILE_RECORD、LEGAL_STAGE、CONTEXT",
                  "type": "string"
                },
                "attachedToProfile": {
                  "description": "是否附於名單",
                  "type": "boolean"
                }
              },
              "required": [
                "ref",
                "id",
                "name",
                "usedFor",
                "attachedToProfile"
              ]
            }
          },
          "summary": {
            "description": "五段式摘要",
