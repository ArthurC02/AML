{
  "$id": "aml:CaseExplanation:v8",
  "type": [
    "object",
    "null"
  ],
  "properties": {
    "caseResult": {
      "description": "案件層級結果",
      "enum": [
        "NOT_APPLICABLE",
        "NO_HIT",
        "REVIEW",
        "HIT",
        "NOT_EVALUATED"
      ]
    },
    "hits": {
