                        "INVESTIGATION",
                        "SEARCH",
                        "QUESTIONING",
                        "ARREST",
                        "REFERRAL",
                        "DETENTION",
                        "BAIL",
                        "ASSET_RESTRAINT",
                        "INDICTMENT",
                        "NON_INDICTMENT",
                        "CONVICTION",
                        "ACQUITTAL",
                        "APPEAL",
                        "CONFISCATION",
                        "FINE",
                        "REGULATORY_PENALTY",
                        "WANTED_NOTICE",
                        "EXTRADITION",
                        "PRIOR_RECORD"
                      ]
                    },
                    "certainty": {
                      "description": "STATED：報導陳述；NEGATED：否定或遭駁回；HEDGED：推測、條件或疑問；REQUESTED：已聲請、尚未裁定",
                      "enum": [
                        "STATED",
                        "NEGATED",
                        "HEDGED",
                        "REQUESTED"
                      ]
                    },
                    "source": {
                      "description": "說法來源：MEDIA（報導本身）、INVESTIGATORS（檢警調）、COURT（法院）、DEFENCE（被告方）、UNNAMED_SOURCE（不具名消息）",
                      "enum": [
                        "MEDIA",
                        "INVESTIGATORS",
                        "COURT",
                        "DEFENCE",
                        "UNNAMED_SOURCE"
                      ]
                    },
                    "actor": {
                      "description": "事件當事人；報導未指明時為 null",
                      "type": [
                        "string",
                        "null"
